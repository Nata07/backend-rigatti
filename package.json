{
  "name": "mini-saas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "lint": "eslint --max-warnings=0 \"src/types/**/*.ts\"",
    "start": "node dist/index.js",
    "seed": "node scripts/seed.js",
    "ts-node:check": "ts-node --project tsconfig.json tests/fixtures/ts-node-smoke.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run type-check",
    "test": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand",
    "test:e2e": "jest tests/e2e --coverage=false --runInBand",
    "test:integration": "jest tests/integration --coverage=false --maxWorkers=50%",
    "test:unit": "jest tests/unit --coverage=false --maxWorkers=50%"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.4.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.35.0",
    "pino": "^10.1.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
